rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- helpers -----
    function signedIn() { return request.auth != null; }
    function isOwnerOnCreate() { return signedIn() && request.resource.data.ownerId == request.auth.uid; }
    function isOwnerOnExisting() { return signedIn() && resource.data.ownerId == request.auth.uid; }

    // Public, read-only app config (adjust the collection name you use; "config" or "settings" are common)
    match /config/{doc=**} {
      allow read: if true;
    }

    // Each user can read/write their own user doc (common during sign-in bootstrap)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Products (what we already had)
    match /products/{id} {
      allow read: if true;

      // Create must include ownerId equal to the caller's uid
      allow create: if isOwnerOnCreate();

      // Owner can update/delete; ownerId must not change
      allow update, delete: if isOwnerOnExisting()
                            && request.resource.data.ownerId == resource.data.ownerId;
    }

    // (add other collections you touch, e.g. carts/orders, similarly)
  }
}
