rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {
function isSignedIn() { return request.auth != null; }


// Image metadata stored at /images/{imageId}
match /images/{imageId} {
allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
allow read, update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
}


// Example products collection with owner control
match /products/{productId} {
allow read: if true; // public catalog
allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
}


// User subcollections private to owner
match /users/{uid}/{document=**} {
allow read, write: if isSignedIn() && request.auth.uid == uid;
}
}
}
