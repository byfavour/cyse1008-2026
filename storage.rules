rules_version = '2';
service firebase.storage {
match /b/{bucket}/o {
// Library images live at images/library/{userId}/{fileName}
match /images/library/{userId}/{fileName} {
// Public if set, otherwise only the owner may read
allow read: if resource.metadata.visibility == 'public' ||
(request.auth != null && request.auth.uid == userId);


// Only the owner may write to their folder
allow write: if request.auth != null && request.auth.uid == userId;
}
}
}
